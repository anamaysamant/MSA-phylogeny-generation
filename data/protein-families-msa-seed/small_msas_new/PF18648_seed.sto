#=GF ID   ADPRTs_Tse2
#=GF AC   PF18648.8
#=GF DE   Tse2 ADP-ribosyltransferase toxin
#=GF AU   El-Gebali S;0000-0003-1378-5495
#=GF AU   Bateman A;0000-0002-6982-4660
#=GF SE   ECOD:EUF08544
